{
  "name": "algoforge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AlgoForge — developer education site (React + Express + Markdown)",
  "workspaces": ["frontend", "server"],
  "engines": { "node": ">=20.12" },
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,cyan \"npm run dev -w server\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "npm start -w server",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0"
  }
}
