# Copy to .env — every value is optional locally.

# Express port (Render sets this automatically)
PORT=5000

# Absolute path to the Markdown content folder (default: ./content)
CONTENT_DIR=

# Only needed if the frontend is hosted on a different origin than the API.
# Comma-separated list, e.g. https://algoforge.dev,https://www.algoforge.dev
CLIENT_ORIGIN=

# Frontend: API base URL. Leave empty when Express serves the built frontend
# (same origin) or when using the Vite dev proxy.
VITE_API_URL=

# Frontend dev only: where the Vite proxy forwards /api (default http://localhost:5000)
VITE_DEV_API=
